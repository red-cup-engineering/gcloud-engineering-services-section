// One bounded Google Cloud operation becomes one actor Activity and receipt.
// The sole public ingress is ActivityPub(CloudEvent(A2A(UCAN, x402, CapTP,
// ...))). This actor keeps no database and does not accept direct public A2A,
// arbitrary shell, or arbitrary gcloud input.
actor urn:ame:gcloud-cloud-run-actuator-service
operations discover-cloud-run-service discover-cloud-run-domain-mapping deploy-cloud-run-service reconcile-cloud-run-service invoke-cloud-run-service
